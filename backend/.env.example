# --- required ---
SECRET_KEY=            # python3 -c "import secrets;print(secrets.token_hex(32))"
SUPER_EMAIL=you@example.com
SUPER_PASSWORD=        # 12+ chars; used only to create the first super admin
DOMAIN=batch28.example.com
DB_PASSWORD=           # python3 -c "import secrets;print(secrets.token_urlsafe(24))"
# --- local dev only (docker-compose sets these itself) ---
DATABASE_URL=postgresql://ndc:devpass@localhost:5432/ndc
PROD=0

# --- security / abuse protection (production) ---
PROXY_KEY=             # long random string; set the SAME value in Vercel. Blocks anyone calling Render directly
TURNSTILE_SECRET=      # Cloudflare Turnstile secret key (free) -> bot check on login + register
MAX_PENDING=300        # stop accepting registrations when this many are waiting for approval
